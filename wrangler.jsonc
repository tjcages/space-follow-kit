{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "space-follow-kit-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-12",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  }
}
